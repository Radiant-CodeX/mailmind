# ─────────────────────────────────────────────────────────────────────────────
# MailMind — environment variable reference
# Copy this to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Session & token security ─────────────────────────────────────────────────
# Generate both keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET_KEY=your-session-secret-key-here
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# Optional TTL overrides (defaults: 24h session, 7d quick login)
# SESSION_TTL_SECONDS=86400
# QUICK_LOGIN_TTL_SECONDS=604800

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Get the connection string from Supabase Dashboard → Settings → Database.
# Use the "Connection string" (postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres)
# Append ?sslmode=require for production.
DATABASE_URL=postgresql://postgres:your_password@db.your_ref.supabase.co:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Queue backend ─────────────────────────────────────────────────────────────
# "memory" → zero deps, single-process (dev/demo)
# "redis"  → durable, multi-worker (staging/production)
QUEUE_BACKEND=memory
# QUEUE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# ── SLA targets (seconds) ─────────────────────────────────────────────────────
SLA_TRIAGE_SECONDS=1.5
SLA_ENRICHMENT_SECONDS=10.0

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
APP_ENV=development          # development | staging | production
APP_RELEASE=mailmind@2.0.0
# SENTRY_DSN=https://...

# ── Compliance / data governance ─────────────────────────────────────────────
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true

# ── Mail ──────────────────────────────────────────────────────────────────────
# true  → demo mode: a sample SRMIST student inbox, no Google account needed
# false → live Gmail (needs the Google OAuth values below)
USE_MOCK_MAIL=true

# ── AI model (server default) ────────────────────────────────────────────────
# Any OpenAI-compatible provider. Each user can also add their OWN key in the
# app's AI settings; this default is used for everyone who hasn't. Leave the key
# empty to run on the built-in rule-based scoring only.
#   openrouter → free models, key at https://openrouter.ai/keys
#   groq       → very fast free tier, key at https://console.groq.com/keys
#   gemini     → free key at https://aistudio.google.com/app/apikey
#   openai | ollama | custom
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Optional overrides (defaults come from the provider preset):
# LLM_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_TRIAGE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=            # only for LLM_PROVIDER=custom
# LLM_EMBEDDING_MODEL=     # empty → free local embeddings
# ALLOW_LOCAL_LLM_ENDPOINTS=false   # true only on a self-hosted box running Ollama

# ── Campus ────────────────────────────────────────────────────────────────────
CAMPUS_NAME=SRM Institute of Science and Technology, Kattankulathur
CAMPUS_SHORT_NAME=SRMIST
CAMPUS_DOMAINS=srmist.edu.in,srmuniv.ac.in

# ── Google / Gmail OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── App config ────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
APPROVAL_TOKEN=change-this-in-production
RATE_LIMIT_PER_MINUTE=100
